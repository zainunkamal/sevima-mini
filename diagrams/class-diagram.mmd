classDiagram
    direction TB

    %% =========================================================================
    %% INTERFACES (ISP & DIP)
    %% =========================================================================
    class IAuthenticatable {
        <<interface>>
        +login(credentials: string) bool
        +logout() void
        +resetPassword(newPassword: string) bool
    }

    class IGradeEvaluator {
        <<interface>>
        +calculateFinalScore(grade: Grade) float
        +convertToLetterGrade(score: float) string
    }

    class IEnrollmentObserver {
        <<interface>>
        +onEnrollmentStatusChanged(enrollment: Enrollment, newStatus: string) void
        +onGradeUpdated(enrollment: Enrollment, grade: Grade) void
    }

    class ValidationRule {
        <<interface>>
        +validate(krs: KRS, mahasiswa: Mahasiswa) bool
    }

    %% =========================================================================
    %% STRATEGY PATTERN: VALIDATION RULES (KRS VALIDATION)
    %% =========================================================================
    class PrerequisiteRule {
        +validate(krs: KRS, mahasiswa: Mahasiswa) bool
    }

    class SksLimitRule {
        -int maxSks
        +validate(krs: KRS, mahasiswa: Mahasiswa) bool
    }

    class ScheduleConflictRule {
        +validate(krs: KRS, mahasiswa: Mahasiswa) bool
    }

    class PaymentValidationRule {
        +validate(krs: KRS, mahasiswa: Mahasiswa) bool
    }

    %% =========================================================================
    %% BASE & SUBCLASSES: USER & ACTORS (SRP & LSP)
    %% =========================================================================
    class User {
        <<abstract>>
        #string id
        #string username
        #string email
        #string passwordHash
        #DateTime createdAt
        +getId() string
        +getUsername() string
        +getEmail() string
    }

    class Mahasiswa {
        -string nim
        -int semester
        -string statusAkademik
        -float ipk
        -Dosen dosenWali
        +getNim() string
        +getDosenWali() Dosen
        +setDosenWali(dosen: Dosen) void
        +isiKRS(krs: KRS) void
        +lihatKRS() List~KRS~
        +lihatKHS() List~Grade~
        +cekStatusPembayaran(semester: int) bool
        +lihatRiwayatPembayaran() List~Payment~
        +onEnrollmentStatusChanged(enrollment: Enrollment, newStatus: string) void
        +onGradeUpdated(enrollment: Enrollment, grade: Grade) void
    }

    class Dosen {
        -string nidn
        -string spesialisasi
        +getNidn() string
        +inputNilai(enrollment: Enrollment, grade: Grade) void
        +lihatJadwalMengajar() List~Schedule~
        +validasiKRS(krs: KRS, persetujuan: bool, catatan: string) void
        +onEnrollmentStatusChanged(enrollment: Enrollment, newStatus: string) void
        +onGradeUpdated(enrollment: Enrollment, grade: Grade) void
    }

    class Admin {
        -string levelAkses
        -List~string~ permissions
        +kelolaUser(user: User) void
        +kelolaKurikulum(course: Course) void
        +verifikasiPembayaran(payment: Payment) void
    }

    class CalonMahasiswa {
        -string noPendaftaran
        -string jalurMasuk
        -string statusSeleksi
        +uploadDokumen(berkasPath: string) void
        +cekStatusPendaftaran() string
    }

    %% =========================================================================
    %% CREATIONAL & AUXILIARY PATTERNS
    %% =========================================================================
    class NIMGenerator {
        +generateNIM(prodi: ProgramStudi, tahunMasuk: int) string
    }

    class UserFactory {
        -NIMGenerator nimGenerator
        +createUser(role: string, data: Map) User
    }

    %% =========================================================================
    %% ACADEMIC & INSTITUTION DOMAIN CORE
    %% =========================================================================
    class ProgramStudi {
        -string kodeProdi
        -string namaProdi
        -string jenjang
        +getKodeProdi() string
        +getNamaProdi() string
        +getJenjang() string
    }

    class Course {
        -string kode
        -string nama
        -int sks
        -string deskripsi
        +getKode() string
        +getNama() string
        +getSks() int
        +tambahPrasyarat(course: Course) void
        +validasiPrasyarat(mahasiswa: Mahasiswa) bool
    }

    class Schedule {
        -string hari
        -string jam
        -string ruangan
        -int kapasitas
        +getHari() string
        +getJam() string
        +getRuangan() string
        +getKapasitas() int
        +cekBentrok(other: Schedule) bool
    }

    class KRS {
        -string idKrs
        -int semester
        -int tahunAkademik
        -string status
        -int totalSks
        +getIdKrs() string
        +getSemester() int
        +getTahunAkademik() int
        +getStatus() string
        +setStatus(status: string) void
        +tambahEnrollment(enrollment: Enrollment) bool
        +batalkanEnrollment(idEnrollment: string) void
        +hitungTotalSks() int
        +getEnrollments() List~Enrollment~
    }

    class Enrollment {
        -string idEnrollment
        -int semester
        -DateTime tanggalDaftar
        -string status
        -List~IEnrollmentObserver~ observers
        +getIdEnrollment() string
        +getSemester() int
        +getStatus() string
        +setStatus(status: string) void
        +batalkanEnrollment() void
        +getGrade() Grade
        +attachObserver(observer: IEnrollmentObserver) void
        +notifyGradeUpdated() void
        +setGradeEvaluator(evaluator: IGradeEvaluator) void
    }

    class Grade {
        -float nilaiTugas
        -float nilaiUTS
        -float nilaiUAS
        -float nilaiAkhir
        -string nilaiHuruf
        +hitungNilaiAkhir(evaluator: IGradeEvaluator) float
        +getNilaiHuruf() string
        +updateNilai(tugas: float, uts: float, uas: float) void
    }

    %% =========================================================================
    %% FINANCIAL / PAYMENT DOMAIN CORE
    %% =========================================================================
    class Payment {
        -string idPayment
        -float jumlah
        -int semester
        -string status
        -string metodePembayaran
        -DateTime batasWaktuBayar
        -DateTime tanggalBayar
        +getIdPayment() string
        +getJumlah() float
        +getStatus() string
        +getSemester() int
        +isLunas() bool
        +konfirmasiPembayaran() bool
    }

    %% =========================================================================
    %% SERVICE LAYER (ORCHESTRATION & NOTIFICATION)
    %% =========================================================================
    class KRSService {
        -List~ValidationRule~ validationRules
        -NotificationService notificationService
        +cekKelayakanPengisianKRS(nim: string, semester: int) bool
        +prosesPengajuanKRS(krs: KRS) bool
        +validasiKRS(krs: KRS, mahasiswa: Mahasiswa) bool
        +approveKRS(krs: KRS, dosenWali: Dosen) void
        +rejectKRS(krs: KRS, dosenWali: Dosen, catatan: string) void
    }

    class PMBService {
        -UserFactory userFactory
        -NotificationService notificationService
        +submitPendaftaran(calon: CalonMahasiswa, prodi: ProgramStudi) string
        +uploadBerkas(noPendaftaran: string, berkasPath: string) bool
        +verifikasiBerkas(noPendaftaran: string, status: string) void
        +sinkronisasiMahasiswaBaru(calon: CalonMahasiswa) Mahasiswa
    }

    class NotificationService {
        +kirimNotifikasi(penerima: User, pesan: string) void
        +broadcastKRSUpdate(krs: KRS, status: string) void
    }

    %% =========================================================================
    %% STRATEGY PATTERN: GRADE EVALUATORS
    %% =========================================================================
    class StandardGradeEvaluator {
        +calculateFinalScore(grade: Grade) float
        +convertToLetterGrade(score: float) string
    }

    class PracticumGradeEvaluator {
        +calculateFinalScore(grade: Grade) float
        +convertToLetterGrade(score: float) string
    }

    %% =========================================================================
    %% RELATIONSHIPS & ASSOCIATIONS
    %% =========================================================================
    %% Interface Realizations (..|>)
    User ..|> IAuthenticatable
    Mahasiswa ..|> IEnrollmentObserver
    Dosen ..|> IEnrollmentObserver
    StandardGradeEvaluator ..|> IGradeEvaluator
    PracticumGradeEvaluator ..|> IGradeEvaluator

    PrerequisiteRule ..|> ValidationRule
    SksLimitRule ..|> ValidationRule
    ScheduleConflictRule ..|> ValidationRule
    PaymentValidationRule ..|> ValidationRule

    %% Generalizations (<|--)
    User <|-- Mahasiswa
    User <|-- Dosen
    User <|-- Admin
    User <|-- CalonMahasiswa

    %% Factory & Creational
    UserFactory ..> User : menginstansiasi
    UserFactory ..> NIMGenerator : mendelegasikan

    %% Program Studi Relations
    ProgramStudi "1" o-- "0..*" Mahasiswa : menaungi
    ProgramStudi "1" o-- "0..*" Course : menyelenggarakan
    CalonMahasiswa ..> ProgramStudi : memilih

    %% Student, Advisor & Study Plan Relations
    Mahasiswa "0..*" --> "1" Dosen : dosen wali
    Mahasiswa "1" *-- "0..*" KRS : memiliki
    Mahasiswa "1" o-- "0..*" Payment : membayar

    %% KRS & Enrollment Composition
    KRS "1" *-- "1..*" Enrollment : memuat
    Enrollment "1" *-- "1" Grade : memiliki nilai
    Enrollment "0..*" o-- "1" Schedule : mengikuti jadwal
    Course "1" *-- "1..*" Schedule : menetapkan jadwal
    Course "1" o-- "0..*" Enrollment : membuka pendaftaran
    Course "0..*" o-- "0..*" Course : prasyarat
    Dosen "1" o-- "0..*" Course : mengajar
    Enrollment "0..*" o-- "0..*" IEnrollmentObserver : diamati oleh
    Enrollment ..> IGradeEvaluator : mendelegasikan evaluasi

    %% Services & Orchestration Dependencies
    KRSService ..> KRS : mengorkestrasi
    KRSService o-- "1..*" ValidationRule : menjalankan aturan
    KRSService ..> NotificationService : mengirim notifikasi

    PMBService ..> CalonMahasiswa : mengelola admisi
    PMBService ..> UserFactory : menggunakan
    PMBService ..> ProgramStudi : menetapkan program studi
    PMBService ..> NotificationService : mengirim notifikasi

    %% Strategy Rules Dependencies
    PaymentValidationRule ..> Payment : memvalidasi tagihan
    PrerequisiteRule ..> Course : memvalidasi prasyarat
    ScheduleConflictRule ..> Schedule : memvalidasi bentrok jadwal
