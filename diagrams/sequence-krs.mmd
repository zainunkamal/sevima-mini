sequenceDiagram
    autonumber
    actor Mhs as 👤 Mahasiswa
    participant Portal as 🌐 Portal SEVIMA-Mini (KRS)
    participant KRSService as ⚙️ Layanan KRS (KRSService)
    participant PayRule as ⚖️ PaymentValidationRule
    participant PrereqRule as ⚖️ PrerequisiteRule
    participant SksRule as ⚖️ SksLimitRule
    participant ConflictRule as ⚖️ ScheduleConflictRule
    participant DoubleRule as ⚖️ DoubleEnrollmentRule
    participant Course as 📚 Entitas Mata Kuliah (Course)
    participant Schedule as 📅 Entitas Jadwal (Schedule)
    participant KRS as 📋 Entitas Rencana Studi (KRS)
    participant Enrollment as 📝 Entitas Pendaftaran (Enrollment)
    participant DB as 🗄️ Database SEVIMA-Mini
    participant NotifService as 🔔 Layanan Notifikasi (NotificationService)
    actor DosenPA as 👨‍🏫 Dosen PA

    Note over Mhs,Portal: Tahap 1: Pengajuan KRS & Validasi Jadwal Periode (Masa KRS)
    Mhs->>Portal: Buka formulir & submit isiKRS(krs)
    Portal->>KRSService: cekKelayakanPengisianKRS(nim, semesterAktif)

    alt Alt Flow 1: Masa Pengisian KRS Telah Ditutup
        KRSService-->>Portal: false (Periode KRS semester aktif telah ditutup)
        Portal-->>Mhs: Error("Pengajuan KRS ditolak: Masa pengisian KRS telah berakhir")
    else Masa Pengisian KRS Aktif (Dibuka)
        KRSService-->>Portal: true (Periode KRS aktif)
        Portal->>KRSService: prosesPengajuanKRS(krs)

        Note over KRSService,PayRule: Tahap 2: Pengecekan Syarat Finansial (Pembayaran SPP)
        KRSService->>PayRule: validate(krs, mahasiswa)
        alt Alt Flow 2: Rule Pembayaran Gagal (Tagihan Belum Lunas)
            PayRule-->>KRSService: false (Status tagihan SPP belum lunas)
            KRSService-->>Portal: Error("KRS Terkunci: Tagihan SPP semester berjalan belum lunas")
            Portal-->>Mhs: Tampilkan peringatan pembayaran & instruksi pelunasan SPP
        else Rule Pembayaran Berhasil (Lunas / Memiliki Dispensasi)
            PayRule-->>KRSService: true (Status SPP lunas)

            Note over KRSService,Schedule: Tahap 3: Pengecekan Kuota Kapasitas Kelas
            loop Untuk Setiap Kelas Matakuliah yang Dipilih
                KRSService->>Schedule: getKapasitas()
                alt Alt Flow 3: Kuota Kapasitas Kelas Penuh
                    Schedule-->>KRSService: 0 (Kapasitas kelas habis)
                    KRSService-->>Portal: Error("Kelas matakuliah [kode] penuh, silakan pilih kelas lain")
                    Portal-->>Mhs: Tampilkan peringatan kapasitas penuh & ganti jadwal
                else Kuota Kapasitas Kelas Tersedia
                    Schedule-->>KRSService: sisaKuota (Kapasitas mencukupi)
                end
            end

            Note over KRSService,DoubleRule: Tahap 4: Eksekusi Multi-Rule Validasi KRS (Strategy Pattern)
            KRSService->>KRSService: validasiKRS(krs, mahasiswa)

            loop Eksekusi Setiap ValidationRule dalam List<ValidationRule>
                alt Evaluasi Rule 1: PrerequisiteRule (Prasyarat Matakuliah)
                    KRSService->>PrereqRule: validate(krs, mahasiswa)
                    PrereqRule->>Course: validasiPrasyarat(mahasiswa)
                    alt Alt Flow 4a: Rule Prasyarat Gagal (Belum Lulus Prasyarat)
                        Course-->>PrereqRule: false (Mata kuliah prasyarat belum lulus)
                        PrereqRule-->>KRSService: false
                        KRSService-->>Portal: Error("Matakuliah [kode] ditolak: prasyarat akademik belum terpenuhi")
                        Portal-->>Mhs: Tampilkan pesan matakuliah prasyarat belum lulus
                    else Rule Prasyarat Berhasil
                        Course-->>PrereqRule: true (Lulus prasyarat)
                        PrereqRule-->>KRSService: true
                    end

                else Evaluasi Rule 2: SksLimitRule (Batas Maksimal SKS <= 24)
                    KRSService->>SksRule: validate(krs, mahasiswa)
                    alt Alt Flow 4b: Rule Batas SKS Gagal (Total SKS > 24)
                        SksRule-->>KRSService: false (Total beban SKS > 24)
                        KRSService-->>Portal: Error("Beban SKS melebihi kuota maksimal: Batas maksimal 24 SKS")
                        Portal-->>Mhs: Tampilkan peringatan beban SKS melebihi ketentuan
                    else Rule Batas SKS Berhasil (Total SKS <= 24)
                        SksRule-->>KRSService: true
                    end

                else Evaluasi Rule 3: ScheduleConflictRule (Deteksi Jadwal Bentrok)
                    KRSService->>ConflictRule: validate(krs, mahasiswa)
                    ConflictRule->>Schedule: cekBentrok(otherSchedule)
                    alt Alt Flow 4c: Rule Bentrok Jadwal Gagal (Jadwal Bertabrakan)
                        Schedule-->>ConflictRule: true (Jadwal bentrok)
                        ConflictRule-->>KRSService: false
                        KRSService-->>Portal: Error("Bentrok jadwal kuliah terdeteksi antara matakuliah terpilih")
                        Portal-->>Mhs: Tampilkan peringatan bentrok hari/jam perkuliahan
                    else Rule Bentrok Jadwal Berhasil (Tidak Ada Bentrok)
                        Schedule-->>ConflictRule: false (Jadwal aman)
                        ConflictRule-->>KRSService: true
                    end

                else Evaluasi Rule 4: DoubleEnrollmentRule (Pencegahan Duplikasi)
                    KRSService->>DoubleRule: validate(krs, mahasiswa)
                    alt Alt Flow 4d: Rule Double Enrollment Gagal (Matakuliah Duplikat)
                        DoubleRule-->>KRSService: false (Matakuliah ganda terdeteksi dalam KRS)
                        KRSService-->>Portal: Error("Matakuliah [kode] sudah terdaftar dalam rencana studi")
                        Portal-->>Mhs: Tampilkan peringatan duplikasi matakuliah
                    else Rule Double Enrollment Berhasil (Tidak Ada Duplikasi)
                        DoubleRule-->>KRSService: true
                    end
                end
            end

            Note over KRSService,Enrollment: Tahap 5: Pembentukan Rencana Studi & Penetapan Status "Pending Approval"
            loop Setiap Matakuliah yang Lolos Validasi
                KRSService->>KRS: tambahEnrollment(enrollment)
                KRSService->>Enrollment: setStatus("PENDING_APPROVAL")
                Enrollment->>Enrollment: attachObserver(mahasiswa)
            end
            KRSService->>KRS: hitungTotalSks()
            KRSService->>KRS: setStatus("PENDING_APPROVAL")

            Note over KRSService,DB: Tahap 6: Persistensi Data ke Basis Data
            KRSService->>DB: simpanKRS(krs)
            alt Alt Flow 5: Terjadi Error Database (Connection Timeout / Failure)
                DB-->>KRSService: Error: DatabaseException (Transaksi gagal di-commit)
                KRSService-->>Portal: Error("Terjadi kegagalan sistem database saat menyimpan data KRS")
                Portal-->>Mhs: Tampilkan notifikasi error server & instruksi submit ulang
            else Transaksi Database Sukses
                DB-->>KRSService: ok (Data KRS tersimpan resmi berstatus "PENDING_APPROVAL")

                Note over KRSService,DosenPA: Tahap 7: Notifikasi Pengajuan KRS ke Dosen PA
                KRSService->>Mhs: getDosenPA()
                Mhs-->>KRSService: dosenPA
                KRSService->>NotifService: kirimNotifikasi(dosenPA, "Pengajuan KRS mahasiswa butuh persetujuan")
                KRSService->>NotifService: broadcastKRSUpdate(krs, "PENDING_APPROVAL")
                NotifService-->>DosenPA: onEnrollmentStatusChanged(enrollment, "PENDING_APPROVAL")
                KRSService-->>Portal: Konfirmasi KRS berhasil diajukan berstatus "PENDING_APPROVAL"
                Portal-->>Mhs: Tampilkan ringkasan draft KRS (Menunggu Persetujuan Dosen PA)

                Note over DosenPA,Mhs: Tahap 8: Evaluasi & Persetujuan Dosen PA
                DosenPA->>Portal: Buka menu validasi KRS mahasiswa bimbingan
                Portal->>KRSService: getDetailKRS(nim, semesterAktif)
                KRSService-->>Portal: krs
                Portal-->>DosenPA: Tampilkan rencana matakuliah & jadwal
                alt Dosen PA Menyetujui KRS (Approve All)
                    DosenPA->>Portal: Setujui KRS (Approve)
                    Portal->>KRSService: approveKRS(krs, dosenPA)
                    KRSService->>KRS: setStatus("APPROVED")
                    KRSService->>Enrollment: setStatus("APPROVED")
                    KRSService->>NotifService: broadcastKRSUpdate(krs, "APPROVED")
                    NotifService-->>Mhs: onEnrollmentStatusChanged(enrollment, "APPROVED")
                    KRSService-->>Portal: Konfirmasi KRS aktif
                    Portal-->>DosenPA: KRS berhasil disetujui
                else Dosen PA Menolak / Minta Revisi KRS
                    DosenPA->>Portal: Tolak KRS (inputCatatanRevisi)
                    Portal->>KRSService: rejectKRS(krs, dosenPA, catatan)
                    KRSService->>KRS: setStatus("REVISED / REJECTED")
                    KRSService->>Enrollment: setStatus("REVISED / REJECTED")
                    KRSService->>NotifService: broadcastKRSUpdate(krs, "REJECTED")
                    NotifService-->>Mhs: onEnrollmentStatusChanged(enrollment, "REJECTED")
                    KRSService-->>Portal: Konfirmasi penolakan tersimpan
                    Portal-->>DosenPA: Status penolakan & catatan terkirim
                end
            end
        end
    end
