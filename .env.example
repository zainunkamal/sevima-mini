# ==============================================================================
# SEVIMA Mini - Environment Configuration Template
# ==============================================================================

# 1. Pilihan Database SQLite (Default lokal tanpa server terpisah):
DATABASE_URL=sqlite:///./sevima_mini.db

# 2. Pilihan Database MySQL (Untuk uji multi-worker InnoDB & lingkungan produksi):
# Aktifkan baris di bawah dan sesuaikan user, password, host, port, dan nama database:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/sevima_mini
